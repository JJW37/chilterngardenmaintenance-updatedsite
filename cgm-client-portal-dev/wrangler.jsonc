{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chilterngardenmaintenance-updatedsite-portal",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "PORTAL_ENVIRONMENT": "preview",
    "PORTAL_DEV_CAPTURE_EMAILS": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cgm-portal-preview-db",
      "database_id": "057b108d-6cec-4926-b5bb-711233584bcb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PORTAL_BUCKET",
      "bucket_name": "cgm-portal-preview-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PORTAL_KV",
      "id": "1a5e348de5d242abb7ce19a4786380f2"
    }
  ]
}
