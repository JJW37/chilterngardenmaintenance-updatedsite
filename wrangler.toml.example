# ==========================================================================
# CGM Client Portal - Cloudflare Pages configuration
# ==========================================================================
# Copy this file to `wrangler.toml` (or set the same bindings in the
# Cloudflare Pages dashboard under Settings > Functions > Bindings).
#
# When using Cloudflare Pages with GitHub integration, the recommended
# approach is to set these bindings in the Pages dashboard (not in
# wrangler.toml) so that they apply to preview deployments too.
#
# Required bindings:
#   DB             - D1 database (client/notes/images/sessions data)
#   PORTAL_BUCKET  - R2 bucket (image storage)
#   PORTAL_KV      - KV namespace (rate-limit storage; optional but recommended)
#
# Required environment variables (set in Pages dashboard > Settings > Environment variables):
#   RESEND_API_KEY       - Resend.com API key (you already have this for /booking/)
#   PORTAL_EMAIL_FROM    - e.g. "Chiltern Garden Maintenance <noreply@chilterngardenmaintenance.com>"
#   SITE_BASE_URL        - e.g. "https://www.chilterngardenmaintenance.com"
#   SESSION_SECRET       - 32+ char random string (generate with: openssl rand -hex 32)
#   MASTER_ADMIN_USER    - admin username (e.g. "cgm-admin")
#   MASTER_ADMIN_PASS    - admin password (recommend sha256-hashed, see README)
# ==========================================================================

name = "chiltern-garden-maintenance"
compatibility_date = "2024-09-23"
pages_build_output_dir = "."

# ---- D1 database binding ----
# Create the database first:
#   wrangler d1 create cgm-portal-db
# Then paste the database_id below.
[[d1_databases]]
binding = "DB"
database_name = "cgm-portal-db"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

# ---- R2 bucket binding (image storage) ----
# Create the bucket first:
#   wrangler r2 bucket create cgm-portal-images
[[r2_buckets]]
binding = "PORTAL_BUCKET"
bucket_name = "cgm-portal-images"

# ---- KV namespace (rate-limit storage) ----
# Create the namespace first:
#   wrangler kv namespace create PORTAL_KV
[[kv_namespaces]]
binding = "PORTAL_KV"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

# ---- Environment variables (non-secret ones can go here; secrets go in the dashboard) ----
# [vars]
# SITE_BASE_URL = "https://www.chilterngardenmaintenance.com"
# PORTAL_EMAIL_FROM = "Chiltern Garden Maintenance <noreply@chilterngardenmaintenance.com>"

# Secrets (set with `wrangler pages secret put ...` or via the Pages dashboard):
#   RESEND_API_KEY
#   SESSION_SECRET
#   MASTER_ADMIN_USER
#   MASTER_ADMIN_PASS
