# Git line-ending configuration for CGM site
# https://docs.github.com/en/get-started/git-basics/configuring-git-to-handle-line-endings
#
# All text files use LF (Unix) line endings in the repo and on checkout.
# This prevents CRLF/LF conversion issues when contributors use Windows.
# GitHub Pages serves files as-is, so LF is what we want.

# Auto-detect text files and normalise line endings to LF on commit
* text=auto eol=lf

# Explicitly mark text files
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
*.webmanifest text eol=lf

# Mark binary files (no line-ending conversion)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
